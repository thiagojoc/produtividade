rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // App de gestão de atividades. Documento único com colunas/tarefas.
    // Login com e-mail e senha (Firebase Auth de verdade): só libera
    // leitura/escrita pro e-mail do Thiago, então mesmo quem descobrir a
    // config do Firebase (sempre pública em app client-side) não consegue
    // ler nem gravar nada sem saber a senha dessa conta.
    //
    // Esse projeto Firebase (flowbody-30162) é compartilhado com outras
    // ferramentas do Thiago (CRM, workshop etc.), então essas regras
    // precisam continuar coladas junto com as delas no Console. A cópia
    // completa e atualizada fica no repositório thiagojoc/flowsales-crm
    // (firestore.rules); este arquivo aqui é só a fatia deste app, pra
    // referência de quem mexer neste repositório.
    match /atividades_app/{docId} {
      allow read, write: if request.auth != null && request.auth.token.email == 'tcaetano1706@gmail.com';
    }
  }
}
